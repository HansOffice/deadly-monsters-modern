{
  "schemaVersion": 1,
  "id": "dmonsters",
  "version": "${version}",
  "name": "Deadly Monsters",
  "description": "Deadly Monsters 原版 Minecraft 1.12.2 模组的 Fabric 26.2 移植版\n保留原版注册标识和玩法身份，并使用当前 Minecraft 与 Fabric API 机制完成迁移",
  "authors": [
    "bigbang87（原作者）",
    "HansOffice（26.2 Fabric 移植）"
  ],
  "contact": {
    "homepage": "https://github.com/HansOffice/deadly-monsters-modern",
    "sources": "https://github.com/HansOffice/deadly-monsters-modern",
    "issues": "https://github.com/HansOffice/deadly-monsters-modern/issues"
  },
  "license": "MIT",
  "icon": "assets/dmonsters/logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.dmonsters.DeadlyMonsters"
    ],
    "client": [
      "com.dmonsters.client.ClientModEvents"
    ]
  },
  "depends": {
